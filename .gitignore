# enthaelt die account-spezifische KV-Namespace-ID. Siehe wrangler.toml.example.
server/wrangler.toml
server/.wrangler/
server/node_modules/

# Praktische Download-Zusammenfassung der Screenshots, kein Versionierungsbedarf
screenshots/*.zip

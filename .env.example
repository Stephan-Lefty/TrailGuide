# URL des deployten Cloudflare-Worker-Relays (siehe server/).
# Fuer lokale Entwicklung mit dem Android-Emulator: http://10.0.2.2:8788
# (feste Adresse, unter der der Emulator den localhost-Rechner erreicht,
# waehrend `npm run dev` im server/-Ordner laeuft).
# Fuer ein echtes Geraet oder Produktion: die tatsaechliche Worker-URL nach
# `npm run deploy` im server/-Ordner eintragen, z.B.
# https://naturlust-trail-guide-relay.<dein-account>.workers.dev
EXPO_PUBLIC_RELAY_API_URL=https://naturlust-trail-guide-relay.naturlust-trail-guide-relay.workers.dev
